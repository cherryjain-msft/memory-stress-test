{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MemorySettings": {
    "DefaultThresholdMB": 512,
    "MaxAllowedThresholdMB": 2048,
    "CleanupIntervalSeconds": 10,
    "MaxConcurrentAllocations": 25,
    "MaxAllocationSizeMB": 256,
    "LowMemoryEvictionThresholdMB": 900
  }
}
