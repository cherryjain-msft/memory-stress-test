{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MemorySettings": {
    "DefaultThresholdMB": 1024,
    "MaxAllowedThresholdMB": 4096,
    "CleanupIntervalSeconds": 30,
    "MaxConcurrentAllocations": 50,
    "MaxAllocationSizeMB": 512,
    "LowMemoryEvictionThresholdMB": 1800
  }
}
